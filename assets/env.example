# Keep this file outside public source control when filled in.
CREATOR_LEAD_SMTP_HOST=
CREATOR_LEAD_SMTP_PORT=587
CREATOR_LEAD_SMTP_USER=
CREATOR_LEAD_SMTP_PASSWORD=
CREATOR_LEAD_SMTP_FROM=
